  },
  "license": "MIT",
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@types/node": "^24.13.3",
    "@types/request": "^2.48.12",
    "@vitest/coverage-v8": "^3.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "build": "tsc --build tsconfig.lib.json --clean && tsc --build tsconfig.lib.json",
