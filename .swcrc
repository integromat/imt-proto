{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "target": "es5",
    "loose": true,
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    }
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": true
}
